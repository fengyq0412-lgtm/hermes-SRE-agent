# 兼容 OpenAI Chat Completions 的模型服务配置。
HERMES_BASE_URL="https://你的兼容服务地址/v1"
HERMES_API_KEY="请在本机填写真实密钥"
HERMES_MODEL="请填写模型名"
# 单次模型回复上限；补丁较长时需要足够的输出空间（256–16384）
HERMES_MAX_OUTPUT_TOKENS=4096

# 项目在页面点击「打开项目」选择，无需配置路径。
HERMES_WEB_PORT=8765

# 每轮带入的近期问答轮数；更早的内容自动增量压缩
HERMES_CONTEXT_RECENT_TURNS=3
# 历史上下文字符预算（不含本轮问题、系统提示及本轮工具输出，不是 token 数）
HERMES_CONTEXT_MAX_CHARS=24000
